# Owner connection: used ONLY for migrations, role setup and seeding (bypasses RLS).
DATABASE_OWNER_URL=postgres://postgres:examio_dev_pw@localhost:5432/examio

# App connection: restricted role, subject to Row Level Security. The web app uses this.
DATABASE_URL=postgres://examio_app:examio_app_dev_pw@localhost:5432/examio
EXAMIO_APP_DB_PASSWORD=examio_app_dev_pw

# Number of reverse proxies you run in front of the app (0-5). The client address for
# sign-in rate limits is read from X-Forwarded-For at that position from the right.
# 0 = no proxy: the header is ignored and only per-account limits apply.
TRUSTED_PROXY_HOPS=0

# Encrypts authenticator-app secrets at rest: 32 random bytes as base64.
# Required when the server runs in production mode (including `pnpm test:e2e`).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes every enrolled authenticator unreadable.
MFA_ENCRYPTION_KEY=

# Environment name: development (default), test, staging or production. Staging and
# production refuse to start without a real scanner, webhook alerts and TRUSTED_PROXY_HOPS.
EXAMIO_ENV=development

# Background worker (pnpm worker) providers
# Email: only "sandbox" exists (messages are recorded, never sent).
EMAIL_PROVIDER=sandbox
# File storage: local disk. Defaults to <repo>/.data/files (git-ignored).
FILE_STORAGE=local
# FILE_STORAGE_DIR=
# Malware scanner for uploads: none (uploads stay quarantined), dev-allow (marks files clean
# WITHOUT scanning; refused in production) or clamav (needs a ClamAV daemon).
FILE_SCANNER=dev-allow
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Alerts: log (default) or webhook (POSTs {"text": ...} to ALERT_WEBHOOK_URL, https only).
ALERT_SINK=log
# ALERT_WEBHOOK_URL=
# LOG_LEVEL=info

# Backups (pnpm ops:backup / ops:restore-rehearsal). Defaults to <repo>/.data/backups.
# BACKUP_DIR=
# Folder with pg_dump/pg_restore if they are not on PATH (Windows installs are found automatically).
# PG_BIN_DIR=

# Test databases (integration tests)
TEST_DATABASE_OWNER_URL=postgres://postgres:examio_dev_pw@localhost:5432/examio_test
TEST_DATABASE_URL=postgres://examio_app:examio_app_dev_pw@localhost:5432/examio_test

# Browser-test database (pnpm test:e2e). Dropped and recreated on every run: it must be a
# local database whose name ends in _e2e.
E2E_DATABASE_OWNER_URL=postgres://postgres:examio_dev_pw@localhost:5432/examio_e2e
E2E_DATABASE_URL=postgres://examio_app:examio_app_dev_pw@localhost:5432/examio_e2e
# msedge (default, uses installed Microsoft Edge) or chromium (Playwright's bundled browser)
# E2E_BROWSER_CHANNEL=msedge

# Seed: first platform super admin
SEED_SUPERADMIN_EMAIL=admin@examio.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026
# PUBLIC demo authenticator key for the seeded admin (development only)
SEED_SUPERADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Online fee payments (Phase 8). sandbox = simulated (development, tests, demo); razorpay = Razorpay
# Orders + webhooks (use TEST keys until live payments are approved). Never commit real keys.
PAYMENTS_PROVIDER=sandbox
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
