# Settings for setting up the FREE hosted demo (Neon database) from your computer.
# Copy to .env.hosted (git-ignored) and fill in. Used only by the pnpm hosted:* commands;
# values here win over .env for those commands. FAKE DATA ONLY on the demo.

# Neon: the "neondb_owner" connection string (Dashboard → Connect). Direct, not pooled.
DATABASE_OWNER_URL=postgresql://neondb_owner:REPLACE@REPLACE.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# The restricted role the website uses. hosted:migrate creates it with this password.
EXAMIO_APP_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Same host and database as above, user examio_app, the password above.
DATABASE_URL=postgresql://examio_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@REPLACE.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password for the two demo school admins (principal@gvps.demo, principal@srv.demo).
# At least 10 characters. Share it only with people you invite to try the demo.
SEED_DEMO_PASSWORD=REPLACE

# Must match MFA_ENCRYPTION_KEY in Vercel (the seed does not use it, kept here for reference).
# MFA_ENCRYPTION_KEY=

# Slack incoming webhook, to rehearse alerts with: pnpm hosted:alert-test
# ALERT_SINK=webhook
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE
# EXAMIO_ENV=demo
