# /etc/examio/web.env: runtime settings for the website and worker (Phase 15.3 runbook).
# Readable by root and the examio user only (chmod 640). Check with:
#   pnpm ops:preflight --settings /etc/examio/web.env --as production --connect
EXAMIO_ENV=production
DATABASE_URL=postgres://examio_app:<password>@127.0.0.1:5432/examio
DATABASE_POOL_MAX=10
TRUSTED_PROXY_HOPS=1
MFA_ENCRYPTION_KEY=<32 random bytes, base64; back up separately; never change>
FILE_STORAGE=local
FILE_STORAGE_DIR=/var/lib/examio/files
FILE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
ALERT_SINK=webhook
ALERT_WEBHOOK_URL=<https webhook, e.g. Slack>
EMAIL_PROVIDER=sandbox
PAYMENTS_PROVIDER=<razorpay with live keys, once live payments are approved>
WORKER_STALE_SECONDS=300
LOG_LEVEL=info
