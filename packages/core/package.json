{
  "name": "@examio/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "seed:e2e": "tsx scripts/seed.ts --e2e",
    "worker": "tsx scripts/worker.ts",
    "alert-test": "tsx scripts/alert-test.ts",
    "seed:hosted": "tsx --env-file=../../.env.hosted scripts/seed.ts --hosted",
    "bootstrap-admin:hosted": "tsx --env-file=../../.env.hosted scripts/bootstrap-admin.ts",
    "alert-test:hosted": "tsx --env-file=../../.env.hosted scripts/alert-test.ts",
    "seed:samples": "tsx scripts/seed-samples.ts",
    "seed:samples:hosted": "tsx --env-file=../../.env.hosted scripts/seed-samples.ts --hosted",
    "preflight": "tsx scripts/preflight.ts",
    "load:exam": "tsx tests/load/exam-load.ts"
  },
  "dependencies": {
    "@examio/db": "workspace:*",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
