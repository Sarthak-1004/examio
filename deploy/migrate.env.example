# /etc/examio/migrate.env: migration and backup settings (Phase 15.3 runbook).
# Readable by root only (chmod 600). Never given to the website or worker.
DATABASE_OWNER_URL=postgres://examio_owner:<password>@127.0.0.1:5432/examio
DATABASE_URL=postgres://examio_app:<password>@127.0.0.1:5432/examio
EXAMIO_APP_DB_PASSWORD=<the examio_app password>
BACKUP_DIR=/var/backups/examio
FILE_STORAGE_DIR=/var/lib/examio/files
